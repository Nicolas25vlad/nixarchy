#!/usr/bin/env bash

# omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omarchy:args=<packages...>
# See omarchy-pkg-present for why this is a command lookup rather than a
# package-database query.
for pkg in "$@"; do
  candidate=${pkg%-bin}
  candidate=${candidate%-stable}
  if ! command -v "$pkg" >/dev/null 2>&1 && ! command -v "$candidate" >/dev/null 2>&1; then
    exit 0
  fi
done
exit 1
